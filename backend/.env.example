# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=raralive
DB_USER=postgres
DB_PASSWORD=your_password

# Auth (used when login/register APIs are wired)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# MSG91 OTP (https://control.msg91.com) — template must contain ##OTP##
# Without these, non-production prints OTPs to the server console instead.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Optional fixed codes for store reviewers / QA, never sent by SMS: "phone:code,phone:code"
OTP_TEST_NUMBERS=
